}

#[test]
fn test_build_action_creates_building() {
    let mut world = World::new(WorldConfig::default());
    let agent = Agent::new(AgentConfig::default());
    let agent_id = agent.id;

    let mut agent_pos = Position(10, 10);
    let build_pos = Position(11, 10);

    let action = Action::ConstructBuilding {
        building_type: BuildingType::Shelter,
        position: build_pos,
    };

    let result = world.execute_action(agent_id, &mut agent_pos, &action, &[]);

    // Should succeed (or indicate construction started)
    // Building should exist at position (even if under construction)
    if result.is_success() {
        assert!(world.has_building_at(build_pos));
    }
}

#[test]
fn test_work_on_construction_progresses_building() {
    let mut world = World::new(WorldConfig::default());
    let agent = Agent::new(AgentConfig::default());
    let agent_id = agent.id;

    let mut agent_pos = Position(10, 10);
    let build_pos = Position(11, 10);

    // Start building
    world.start_building(build_pos, BuildingType::Shelter);

    // Work on it
    let action = Action::WorkOnConstruction {
        building_position: build_pos,
        work_amount: 10,
        worker_skill: 5,
    };

    let result = world.execute_action(agent_id, &mut agent_pos, &action, &[]);

    // Should succeed or show partial progress
    assert!(
        result.is_success() || matches!(result, ActionResult::Partial { .. }),
        "Construction work should progress"
    );
}

#[test]
fn test_deposit_items_into_storage() {
    let mut world = World::new(WorldConfig::default());
    let mut agent = Agent::new(AgentConfig::default());
    let agent_id = agent.id;

    let mut agent_pos = Position(10, 10);

    // Agent has items to deposit
    agent.inventory.add_item(crate::agents::InventoryItem::new("wood".to_string(), 50));

    // Create a storehouse nearby
    world.add_building(Position(11, 10), BuildingType::Storehouse);

    let action = Action::DepositItems {
        item_type: ItemType::Wood,
        amount: 20,
    };

    let result = world.execute_action(agent_id, &mut agent_pos, &action, &[]);

    // Should succeed
    assert!(result.is_success());
}

#[test]
fn test_retrieve_items_from_storage() {
    let mut world = World::new(WorldConfig::default());
    let agent = Agent::new(AgentConfig::default());
    let agent_id = agent.id;

    let mut agent_pos = Position(10, 10);

    // Create storehouse with items
    let storehouse_pos = Position(11, 10);
    world.add_building(storehouse_pos, BuildingType::Storehouse);
    world.add_to_storage(ItemType::Stone, 100);

    let action = Action::RetrieveItems {
        item_type: ItemType::Stone,
        amount: 30,
    };

    let result = world.execute_action(agent_id, &mut agent_pos, &action, &[]);

    // Should succeed if storage has items
    if world.storage_has(ItemType::Stone, 30) {
        assert!(result.is_success());
    }
}

#[test]
fn test_action_result_success_detection() {
    let success = ActionResult::Success {
        message: "Done".to_string(),
    };

    let success_with_items = ActionResult::SuccessWithItems {
        message: "Harvested".to_string(),
        item_type: ItemType::Wood,
        quantity: 10,
    };

    let failure = ActionResult::Failure {
        reason: "No resource".to_string(),
    };

    assert!(success.is_success());
    assert!(success_with_items.is_success());
    assert!(!failure.is_success());
}

#[test]
fn test_action_result_item_extraction() {
    let result = ActionResult::SuccessWithItems {
        message: "Harvested wood".to_string(),
        item_type: ItemType::Wood,
        quantity: 15,
    };

    let (item_type, quantity) = result.take_items().unwrap();
    assert_eq!(item_type, ItemType::Wood);
    assert_eq!(quantity, 15);
}

#[test]
fn test_partial_action_result() {
    let partial = ActionResult::Partial {
        completed: 0.6,
        message: "60% complete".to_string(),
    };

    // Partial results are not considered full success
    assert!(!partial.is_success());
}

#[test]
fn test_social_action_result_extracts_satisfaction() {
    let social = ActionResult::SocialSuccess {
        message: "Had nice chat".to_string(),
        relationship_change: 5,
        trust_change: 2,
        social_satisfaction: 0.3,
    };

    assert!(social.is_success());
    assert_eq!(social.social_satisfaction(), 0.3);

    let (rel_change, trust_change) = social.relationship_change();
    assert_eq!(rel_change, 5);
    assert_eq!(trust_change, 2);
}
