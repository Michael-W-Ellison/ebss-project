// src/world/tests/action_execution_tests.rs
//! TDD tests for the action execution system
//!
//! These tests verify that actions:
//! - Execute with correct preconditions
//! - Produce expected results (success/failure)
//! - Consume/produce resources correctly
//! - Update world state appropriately

use crate::world::{World, WorldConfig, Action, ActionResult, Position, ResourceType, BuildingType, ItemType};
use crate::agents::{Agent, AgentConfig};
use uuid::Uuid;

#[test]
fn test_harvest_action_success() {
    let mut world = World::new(WorldConfig::default());
    let mut agent = Agent::new(AgentConfig::default());
    let agent_id = agent.id;

    // Place agent at position
    let mut agent_pos = Position(10, 10);

    // Ensure there's a wood resource nearby
    world.add_resource(Position(10, 11), ResourceType::Wood, 100);

    // Execute harvest action
    let action = Action::HarvestResource {
        resource_position: Position(10, 11),
        resource_type: ResourceType::Wood,
        amount: 10,
    };

    let result = world.execute_action(agent_id, &mut agent_pos, &action, &[]);

    // Should succeed
    assert!(result.is_success(), "Harvest should succeed with nearby resource");

    // Should return harvested items
    if let Some((item_type, quantity)) = result.take_items() {
        assert_eq!(item_type, ItemType::Wood);
        assert!(quantity > 0 && quantity <= 10);
    } else {
        panic!("Harvest should return items");
    }
}

#[test]
fn test_harvest_action_fails_when_resource_too_far() {
    let mut world = World::new(WorldConfig::default());
    let agent = Agent::new(AgentConfig::default());
    let agent_id = agent.id;

    let mut agent_pos = Position(10, 10);

    // Place resource far away
    world.add_resource(Position(50, 50), ResourceType::Wood, 100);

    let action = Action::HarvestResource {
        resource_position: Position(50, 50),
        resource_type: ResourceType::Wood,
        amount: 10,
    };

    let result = world.execute_action(agent_id, &mut agent_pos, &action, &[]);

    // Should fail - too far
    assert!(!result.is_success());
}

#[test]
fn test_harvest_depletes_resource() {
    let mut world = World::new(WorldConfig::default());
    let agent = Agent::new(AgentConfig::default());
    let agent_id = agent.id;

    let mut agent_pos = Position(10, 10);
    let resource_pos = Position(10, 11);

    // Add resource with limited amount
    world.add_resource(resource_pos, ResourceType::Stone, 20);

    // Harvest 15 units
    let action = Action::HarvestResource {
        resource_position: resource_pos,
        resource_type: ResourceType::Stone,
        amount: 15,
    };

    world.execute_action(agent_id, &mut agent_pos, &action, &[]);

    // Resource should have 5 or less remaining (depending on harvesting mechanics)
    if let Some(resource) = world.get_resource_at(resource_pos) {
        assert!(resource.amount <= 20);
    }
}

#[test]
fn test_harvest_cannot_exceed_available_amount() {
    let mut world = World::new(WorldConfig::default());
    let agent = Agent::new(AgentConfig::default());
    let agent_id = agent.id;

    let mut agent_pos = Position(10, 10);
    let resource_pos = Position(10, 11);

    // Add small resource
    world.add_resource(resource_pos, ResourceType::Wood, 5);

    // Try to harvest more than available
    let action = Action::HarvestResource {
        resource_position: resource_pos,
        resource_type: ResourceType::Wood,
        amount: 100,
    };

    let result = world.execute_action(agent_id, &mut agent_pos, &action, &[]);

    // Should succeed but only harvest what's available
    if let Some((_, quantity)) = result.take_items() {
        assert!(quantity <= 5, "Cannot harvest more than available");
    }
}

#[test]
fn test_rest_action_always_succeeds() {
    let mut world = World::new(WorldConfig::default());
    let agent = Agent::new(AgentConfig::default());
    let agent_id = agent.id;

    let mut agent_pos = Position(10, 10);

    let action = Action::Rest { duration: 10 };

    let result = world.execute_action(agent_id, &mut agent_pos, &action, &[]);

    assert!(result.is_success(), "Rest should always succeed");
}

#[test]
fn test_move_action_updates_position() {
    let mut world = World::new(WorldConfig::default());
    let agent = Agent::new(AgentConfig::default());
    let agent_id = agent.id;

    let mut agent_pos = Position(10, 10);
    let destination = Position(11, 10);

    let action = Action::MoveTo { destination };

    let result = world.execute_action(agent_id, &mut agent_pos, &action, &[]);

    // Should succeed
    assert!(result.is_success());

    // Position should have updated (or moved toward destination)
    // Depending on implementation, might not reach in one step
    assert!(agent_pos.0 >= 10 && agent_pos.0 <= 11);
}

#[test]
fn test_move_action_respects_occupied_positions() {
    let mut world = World::new(WorldConfig::default());
    let agent = Agent::new(AgentConfig::default());
    let agent_id = agent.id;

    let mut agent_pos = Position(10, 10);
    let destination = Position(11, 10);

    // Another agent occupies the destination
    let occupied_positions = vec![Position(11, 10)];

    let action = Action::MoveTo { destination };

    let result = world.execute_action(agent_id, &mut agent_pos, &action, &occupied_positions);

    // Should fail or find alternate path
    // Position should not be at occupied location
    assert_ne!(agent_pos, Position(11, 10));
}

